<Project Sdk="Microsoft.NET.Sdk">

  <!-- 単体テスト（xUnit v3）。IMAP・llama-server・Windows はインターフェースの偽物に差し替える -->
  <PropertyGroup>
    <TargetFramework>$(DotNetVersion)-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoMailChecker.Core\AutoMailChecker.Core.csproj" />
    <ProjectReference Include="..\..\src\AutoMailChecker.Mail\AutoMailChecker.Mail.csproj" />
    <ProjectReference Include="..\..\src\AutoMailChecker.Llm\AutoMailChecker.Llm.csproj" />
    <ProjectReference Include="..\..\src\AutoMailChecker.Windows\AutoMailChecker.Windows.csproj" />
    <ProjectReference Include="..\..\src\AutoMailChecker.App\AutoMailChecker.App.csproj" />
  </ItemGroup>

</Project>
