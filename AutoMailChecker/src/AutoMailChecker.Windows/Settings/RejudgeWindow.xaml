<Window x:Class="AutoMailChecker.Windows.Settings.RejudgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMailChecker.Windows.Settings"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:RejudgeViewModel}"
        Title="試し判定 - AutoMailChecker"
        Width="900" Height="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutoMailChecker.Windows;component/Ui/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding AvailabilityText}" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="閉じる" IsCancel="True" Margin="0" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Margin="0,12,0,0" MinHeight="170">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="選んだメールを判定する" Command="{Binding RunCommand}" IsDefault="True" />
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{StaticResource StatusPlanned}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         Background="Transparent" VerticalContentAlignment="Top" />
            </DockPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Recent}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEEF1"
                  RowHeight="24" Background="White" BorderBrush="{StaticResource PanelBorder}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="受信日時" Binding="{Binding ReceivedText}" Width="128" />
                <DataGridTextColumn Header="アカウント" Binding="{Binding Account}" Width="80" />
                <DataGridTextColumn Header="件名" Binding="{Binding Subject}" Width="*" />
                <DataGridTemplateColumn Header="前回の結果" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DestinationText}" Style="{StaticResource DestinationText}" VerticalAlignment="Center"
                                       Margin="4,0" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
