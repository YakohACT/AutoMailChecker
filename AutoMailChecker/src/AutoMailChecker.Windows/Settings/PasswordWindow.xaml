<Window x:Class="AutoMailChecker.Windows.Settings.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="パスワードの登録 - AutoMailChecker"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutoMailChecker.Windows;component/Ui/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                   Text="iCloud は「App用パスワード」、Gmail は「アプリ パスワード」を入力してください。Windows 資格情報マネージャーにだけ保存し、画面にも設定ファイルにも出しません。" />
        <PasswordBox x:Name="PasswordInput" Padding="3,2" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="登録" Click="OnOkClick" IsDefault="True" />
            <Button Content="キャンセル" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
