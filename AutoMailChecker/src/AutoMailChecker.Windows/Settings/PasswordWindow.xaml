<Window x:Class="AutoMailChecker.Windows.Settings.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AutoMailChecker.Windows.Ui"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutoMailChecker.Windows;component/Ui/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
        <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,0,0,12" />
        <PasswordBox x:Name="PasswordInput" Padding="3,2" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Translate '登録', 'Register'}" Click="OnOkClick" IsDefault="True" />
            <Button Content="{l:Translate 'キャンセル', 'Cancel'}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
